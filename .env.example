################################################################################
# EXECUTION MODE CONFIGURATION
################################################################################
# Configure execution mode for each component independently
# This allows fine-grained control over which services run locally vs. remotely
#
# LLM_MODE: Large Language Model execution mode
#           - online: Use remote LLM API (lightweight, no local model required)
#                     Example: Use Ollama, vLLM, or cloud APIs remotely
#           - local: Run LLM model locally (requires transformers, torch)
#                    Example: Run qwen-vl locally with full dependencies
#           Default: online
#
# UI_INS_MODE: UI-Ins element localization execution mode
#              - online: Use remote UI-Ins API
#              - local: Run UI-Ins model locally (requires transformers, torch)
#              Default: online
#
# RAG_MODE: RAG functionality
#           - online: Use remote embedding API
#           - local: Use local embedding model (requires llama-index, transformers)
#           Default: online (RAG disabled in online mode)
#
# Configuration Examples:
# 1. Lightweight setup (all online):
#    LLM_MODE=online
#    UI_INS_MODE=online
#    RAG_MODE=online
#
# 2. Mixed setup (LLM local, UI-INS online):
#    LLM_MODE=local
#    UI_INS_MODE=online
#    RAG_MODE=online
#
# 3. Full local setup (all offline):
#    LLM_MODE=local
#    UI_INS_MODE=local
#    RAG_MODE=local
LLM_MODE=online
UI_INS_MODE=online
RAG_MODE=online


################################################################################
# OPENTERFACE DEVICE CONFIGURATION
################################################################################
# Configure connection to your Openterface device/server
# The device streams screen captures via TCP connection
#
# OPENTERFACE_HOST: IP address or hostname of your Openterface device
#                   Examples: localhost, 192.168.1.100, device.local
# OPENTERFACE_PORT: TCP port number the Openterface server listens on
#                   Default: 12345
OPENTERFACE_HOST=localhost
OPENTERFACE_PORT=12345


################################################################################
# MAIN AI API CONFIGURATION
################################################################################
# Configure the primary LLM API endpoint for chat completions
# Supports OpenAI-compatible APIs (Ollama, vLLM, LM Studio, etc.)
#
# API_URL: Full endpoint URL for chat completions
#          Examples:
#          - http://localhost:11434/v1/chat/completions (Ollama)
#          - http://localhost:8000/v1/chat/completions (vLLM)
#          - http://192.168.1.100:1234/v1/chat/completions (LM Studio)
#
# MODEL: The model name to use for API requests
#        Must be available on your API server
#        Examples: qwen3-vl:32b, llama2, mistral, etc.
#
# LLM_API_KEY: Bearer token for authentication with the LLM API
#              Set to "EMPTY" if authentication is not required
API_URL=http://localhost:11434/v1/chat/completions
MODEL=qwen3-vl:32b
LLM_API_KEY=EMPTY


################################################################################
# UI-INS ELEMENT LOCALIZATION MODEL
################################################################################
# Configure the specialized transformer model for UI element detection
# Used to identify and locate UI elements in screenshots for automation
#
# UI_INS_API_URL: Endpoint for the UI-Ins API server
#                 Example: http://localhost:2345/v1/chat/completions
#
# UI_INS_MODEL: The UI-Ins model name (visual grounding model)
#               Example: ui-ins-7b
#
# UI_INS_API_KEY: Bearer token for authentication with the UI-Ins API
#                 Set to "EMPTY" if authentication is not required
UI_INS_API_URL=http://localhost:2345/v1/chat/completions
UI_INS_MODEL=ui-ins-7b
UI_INS_API_KEY=EMPTY

# UI-INS Server Configuration (if running UI-INS server locally)
#
# UI_INS_MODEL_PATH: Path to the UI-INS model directory
#                    Examples:
#                    - Linux/Mac: /home/user/models/ui-ins-7b
#                    - Windows: C:\models\ui-ins-7b
#                    - Default: D:\AI\models\UI-Ins-7B
#
# UI_INS_SERVER_HOST: Host address to run the UI-INS server on
#                     Examples:
#                     - 0.0.0.0 (listen on all interfaces)
#                     - 127.0.0.1 (localhost only)
#                     - 192.168.1.10 (specific IP)
#                     Default: 0.0.0.0
#
# UI_INS_SERVER_PORT: Port for the UI-INS server, must match UI_INS_API_URL port
#                     Default: 2345
UI_INS_MODEL_PATH=/path/to/ui-ins-7b
UI_INS_SERVER_HOST=0.0.0.0
UI_INS_SERVER_PORT=2345


################################################################################
# RAG (RETRIEVAL-AUGMENTED GENERATION) CONFIGURATION
################################################################################
# Configure document retrieval and embedding settings
# Used to enhance AI responses with relevant documents from your knowledge base
#
# RAG_API_BASE: Base URL for the embedding model API
#               Example: http://localhost:11434/v1
#
# RAG_EMBED_MODEL: The embedding model to use for document vectors
#                  Example: qwen3-embedding:0.6b
#
# RAG_INDEX_DIR: Directory where the built document index is stored
#                Default: ./index
#
# RAG_DOCS_DIR: Directory containing source documents for indexing
#               Supported formats: .txt, .md, .mhtml, .pdf
#               Default: ./docs
RAG_API_BASE=http://localhost:11434/v1
RAG_EMBED_MODEL=qwen3-embedding:0.6b
RAG_INDEX_DIR=./index
RAG_DOCS_DIR=./docs
